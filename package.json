{
  "name": "discord-colornames",
  "version": "4.4.0",
  "description": "A Discord bot that manages color-based roles in a Discord server.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "docker:build": "docker build -t discord-colornames:dev .",
    "docker:run": "docker run --env-file .env discord-colornames:dev",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sneaks-Community/discord-colornames"
  },
  "bugs": {
    "url": "https://github.com/Sneaks-Community/discord-colornames/issues"
  },
  "keywords": [
    "discord",
    "bot",
    "color-roles",
    "discord.js"
  ],
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "undici": "6.28.0"
  }
}

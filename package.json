{
  "name": "discord-colornames",
  "version": "4.4.2",
  "description": "A Discord bot that manages color-based roles in a Discord server.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "docker:build": "docker build -t discord-colornames:dev .",
    "docker:run": "docker run --env-file .env discord-colornames:dev",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sneaks-Community/discord-colornames"
  },
  "bugs": {
    "url": "https://github.com/Sneaks-Community/discord-colornames/issues"
  },
  "keywords": [
    "discord",
    "bot",
    "color-roles",
    "discord.js"
  ],
  "dependencies": {
    "discord.js": "^14.27.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-unicorn": "^77.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}

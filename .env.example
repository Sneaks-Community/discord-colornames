# Discord Bot Token (get from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Discord Client ID (from Developer Portal)
DISCORD_CLIENT_ID=your_client_id_here

# Server/Guild ID where commands should be registered
SERVER_ID=your_server_id_here

# Channel ID to pin the color list message to (optional - if empty, no pinning occurs)
# PIN_CHANNEL_ID=your_channel_id_here

# Embed color (decimal, e.g., 299410 = teal)
EMBED_COLOR=299410

# Title shown on the color list embed (and used to detect the pinned message)
COLOR_LIST_TITLE=Color Roles

# Logger level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Health check server port
HEALTH_PORT=3000

# Access denied message shown to users without allowed roles
# Supports markdown links, e.g., [donate here](https://example.com/donate)
ACCESS_DENIED_DESCRIPTION=Sorry, this command is for VIPs and Nitro Boosters only.

# Allowed roles for color commands (comma-separated role IDs)
# These are the roles that allow users to use /color and /colors commands
ALLOWED_ROLES=role_id_1,role_id_2

# Color role mappings
# Each COLOR_ROLE_<NAME> maps a color name to its Discord role ID
# The number shown to users follows the order these entries appear below
COLOR_ROLE_BLUE=role_id_here
COLOR_ROLE_GREEN=role_id_here
COLOR_ROLE_RED=role_id_here
